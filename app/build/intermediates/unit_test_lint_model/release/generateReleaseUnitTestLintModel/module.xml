<lint-module
    format="1"
    dir="/workspace/app"
    name=":app"
    type="APP"
    maven="WatchaWatch:app:unspecified"
    agpVersion="8.13.2"
    buildFolder="build"
    bootClassPath="/opt/android-sdk-linux/platforms/android-36/android.jar:/opt/android-sdk-linux/build-tools/35.0.0/core-lambda-stubs.jar"
    javaSourceLevel="17"
    compileTarget="android-36"
    neverShrinking="true">
